.result-card{border-radius:34rpx;padding:44rpx 30rpx;margin-bottom:24rpx;color:white;text-align:center;box-shadow:0 16rpx 42rpx rgba(0,0,0,.12)}.available{background:linear-gradient(135deg,#008B8B,#0EA66B)}.registered{background:linear-gradient(135deg,#B42318,#F79009)}.unknown{background:linear-gradient(135deg,#003D7A,#C9A961)}.status-icon{font-size:70rpx}.r-title{font-size:42rpx;font-weight:900;margin:10rpx 0}.r-sub{opacity:.9}.risk{margin-top:22rpx;background:rgba(255,255,255,.18);border-radius:20rpx;padding:18rpx;font-weight:700}.mini{margin-top:0}.advice{font-size:28rpx;line-height:1.75;color:#344054;margin-bottom:24rpx}.course-title{font-size:32rpx;font-weight:900;color:#003D7A}.small-btn{margin-top:18rpx;border:2rpx solid #C9A961;color:#C9A961;border-radius:40rpx;height:72rpx;display:flex;align-items:center;justify-content:center;font-weight:700}.disclaimer-link{text-align:center;padding:32rpx 0 16rpx;font-size:24rpx;color:#667085;text-decoration:underline}
.lang-row{display:flex;gap:10rpx;flex-wrap:wrap;margin-bottom:20rpx;justify-content:flex-start;flex-direction:row}.lang-pill{font-size:22rpx;padding:10rpx 16rpx;border-radius:999rpx;background:#fff;color:#003D7A;border:1rpx solid #D0D5DD;display:inline-block;direction:ltr;text-align:left}.lang-pill.active{background:#C9A961;color:#fff;border-color:#C9A961}button.btn{border:0}button.btn::after{border:0}
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:999}.modal-overlay.hidden{display:none}.disclaimer-modal{background:#fff;border-radius:34rpx;padding:36rpx;margin:0 30rpx;max-width:650rpx;max-height:80vh;display:flex;flex-direction:column}.disclaimer-title{font-size:34rpx;font-weight:900;color:#003D7A;text-align:center;margin-bottom:24rpx;flex-shrink:0}.disclaimer-body{flex:1;overflow-y:scroll;min-height:0;margin-bottom:24rpx;-webkit-overflow-scrolling:touch}.disclaimer-body .sec-title{font-size:30rpx;font-weight:700;color:#003D7A;margin:20rpx 0 12rpx}.disclaimer-body .para{font-size:26rpx;line-height:1.7;color:#344054;margin-bottom:12rpx;text-align:justify}.checkbox-row{display:flex;align-items:flex-start;gap:16rpx;margin:16rpx 0;padding:16rpx;background:#F9FAFB;border-radius:16rpx}.checkbox{width:36rpx;height:36rpx;border-radius:6rpx;border:2rpx solid #D0D5DD;flex-shrink:0;display:flex;align-items:center;justify-content:center}.checkbox.checked{background:#003D7A;border-color:#003D7A}.checkmark{color:#fff;font-size:24rpx;font-weight:700}.checkbox-label{font-size:24rpx;line-height:1.5;color:#344054;flex:1}.btn-disabled{background:#D0D5DD;color:#fff;border-radius:40rpx;height:80rpx;display:flex;align-items:center;justify-content:center;font-weight:700;width:100%;flex-shrink:0}
