<view class="lang-row light">
  <view class="lang-pill {{lang==='zh'?'active':''}}" data-lang="zh" bindtap="changeLang">中文</view>
  <view class="lang-pill {{lang==='kkArab'?'active':''}}" data-lang="kkArab" bindtap="changeLang">قازاقشا</view>
  <view class="lang-pill {{lang==='kkCyrl'?'active':''}}" data-lang="kkCyrl" bindtap="changeLang">Қазақша</view>
</view>
<view class="container {{rtl?'rtl':''}}">
  <view class="result-card {{status}}">
    <view class="status-icon">{{icon}}</view>
    <view class="r-title">{{title}}</view>
    <view class="r-sub">{{t.trademark}}：{{keyword}}</view>
    <view class="risk">{{risk}}</view>
  </view>
  <view class="card">
    <view class="section-title mini">{{t.resultAdvice}}</view>
    <view class="advice">{{advice}}</view>
    <button class="btn btn-gold" bindtap="goConsult">{{t.consultReview}}</button>
  </view>
  <view class="card course">
    <view class="course-title">{{t.courseTitle}}</view>
    <view class="muted">{{t.courseSub}}</view>
    <view class="small-btn">{{t.learnNow}}</view>
  </view>
  <view class="disclaimer-link" bindtap="showDisclaimer">{{t.disclaimerViewLink}}</view>
</view>

<view class="modal-overlay {{showDisclaimer?'':'hidden'}}">
  <view class="disclaimer-modal {{rtl?'rtl':''}}">
    <view class="disclaimer-title">{{t.disclaimerTitle}}</view>
    <view class="disclaimer-body">
      <view wx:for="{{t.disclaimerIntro}}" wx:for-item="para" wx:key="*this" class="para">{{para}}</view>
      <view wx:for="{{t.disclaimerSections}}" wx:for-item="sec" wx:key="title">
        <view class="sec-title">{{sec.title}}</view>
        <view wx:for="{{sec.items}}" wx:for-item="para" wx:key="*this" class="para">{{para}}</view>
      </view>
      <view class="checkbox-row" bindtap="toggleAgreed">
        <view class="checkbox {{agreed?'checked':''}}">
          <view wx:if="{{agreed}}" class="checkmark">✓</view>
        </view>
        <view class="checkbox-label">{{t.disclaimerCheckbox}}</view>
      </view>
    </view>
    <button class="btn {{agreed?'btn-gold':'btn-disabled'}}" disabled="{{!agreed}}" bindtap="acceptDisclaimer">{{t.disclaimerConfirm}}</button>
  </view>
</view>
